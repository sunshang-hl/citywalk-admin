# ============================================
# citywalk-admin 环境配置模板（复制为 .env.development 使用）
# 敏感值不入库；Logto Console 需登记 redirect URI / CORS
#
# ⚠️ 共用后端环境说明：
# 开发/测试阶段与 OmniAdmin 共用同一套 OmniPG 后端
# （同一 PostgREST API、同一 Logto 实例与组织、同一菜单/权限数据）。
# 正式上线前需切换为 citywalk 独立配置：
#   1. VITE_API_URL → citywalk 独立 API 地址
#   2. VITE_LOGTO_* → Logto Console 为 citywalk 单独创建 SPA 应用后填入
#   3. VITE_SYSTEM_NAME → 上线正式名称（如 CityWalk Admin）
# ============================================

# API 基础地址（PostgREST；开发阶段与 OmniAdmin 共用，上线时改为 citywalk 独立地址）
VITE_API_URL=http://localhost:3100

# 是否携带凭证（cookies）
VITE_WITH_CREDENTIALS=false

# 应用版本
VITE_VERSION=1.0.0

# 系统名称（开发阶段建议 CityWalk Admin；上线时确认为正式名称）
VITE_SYSTEM_NAME=CityWalk Admin

# 开发端口（3006=OmniAdmin 主端口，3007=OmniAdmin 备用端口（已在 Logto 登记，两项目可并行开发）；上线时按 citywalk 域名另配）
VITE_PORT=3007

# 权限模式【 frontend 前端模式 / backend 后端模式（当前默认，菜单由数据库驱动） 】
VITE_ACCESS_MODE=backend

# ============================================
# Logto OIDC（全托管认证）
# 开发阶段与 OmniAdmin 共用实例/应用；上线前为 citywalk 单独创建应用
# ============================================
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=
VITE_LOGTO_REDIRECT_URI=http://localhost:3007/auth/callback
VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:3007/auth/login
# 业务组织（Logto Organization）ID——组织级 RLS 依赖组织 token，开发/部署时必填
VITE_LOGTO_ORGANIZATION_ID=
